<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Pyramids Wallet" />

        <TextView
            android:id="@+id/widget_network"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Pyramids Wallet"
            android:textColor="#8B949E"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="— MAS"
        android:textColor="#E5344A"
        android:textSize="24sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/widget_rolls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 rolls"
            android:textColor="#F0883E"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="AU1…"
        android:textColor="#8B949E"
        android:textSize="10sp"
        android:fontFamily="monospace" />
</LinearLayout>
